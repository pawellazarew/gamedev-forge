{
  "name": "game-forge",
  "version": "0.1.0",
  "description": "Local web-game testing, browser scenarios, performance probes and balance simulation.",
  "type": "module",
  "bin": {
    "forge": "./bin/forge.mjs"
  },
  "scripts": {
    "doctor": "node bin/forge.mjs doctor",
    "test": "node --test test/*.test.mjs",
    "test:unit": "node --test test/unit-*.test.mjs",
    "test:e2e": "node --test test/e2e-*.test.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.60.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pawellazarew/gamedev-forge.git",
    "directory": "game-forge"
  },
  "private": true
}
